function buildSellerListing(state) {

  const a = state.answers;

  const get = (key, fallback = "Not provided") => {
    if (Array.isArray(a[key])) {
      return a[key].length ? a[key].join(", ") : fallback;
    }

    return a[key] || fallback;
  };


  return {
    productName: get("product_name"),
    productType: get("product_type"),
    category: get("category"),

    description: get("short_description"),

    maturity: get("maturity"),

    platforms: get("platforms"),

    technologyStack: get("tech_stack"),
    integrations: get("integrations"),

    usesAI: get("uses_ai"),
    aiCapabilities: get("ai_capabilities"),
    aiModels: get("ai_models"),

    businessModel: get("business_model"),
    targetCustomer: get("target_customer"),
    targetMarket: get("target_market"),

    businessDescription: get("business_description"),

    revenueStatus: get("has_revenue"),
    monthlyRevenue: get("monthly_revenue"),
    annualRevenue: get("annual_revenue"),
    customers: get("customers"),
    activeUsers: get("active_users"),

    askingPrice: get("asking_price"),
    currency: get("currency"),
    dealType: get("deal_type"),
    priceReason: get("price_reason"),

    competitors: get("competitors"),
    competitiveAdvantage: get("competitive_advantage"),
    growthOpportunity: get("growth_opportunity"),

    ownership: get("ownership"),
    rightsIncluded: get("rights_included"),
    thirdPartyDependencies: get("third_party_dependencies"),

    demoUrl: get("demo_url"),
    websiteUrl: get("website_url"),
    verificationNotes: get("verification_notes")
  };
}


function renderSellerListingPreview(state) {

