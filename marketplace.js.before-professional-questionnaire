  questionArea.appendChild(intro);


  const listingCard = document.createElement("article");

  listingCard.className = "technology-listing-preview";


  const title = document.createElement("h2");

  title.textContent = listing.productName;

  listingCard.appendChild(title);


  const badge = document.createElement("div");

  badge.className = "listing-badge";

  badge.textContent =
    `${listing.productType} • ${listing.category}`;

  listingCard.appendChild(badge);


  addListingSection(
    listingCard,
    "Overview",
    [
      ["Description", listing.description],
      ["Product Stage", listing.maturity],
      ["Platforms", listing.platforms]
    ]
  );


  addListingSection(
    listingCard,
    "Technology",
    [
      ["Technology Stack", listing.technologyStack],
      ["Integrations", listing.integrations]
    ]
  );


  if (
    listing.usesAI === "Yes" ||
    listing.usesAI === "AI is optional"
  ) {

    addListingSection(
      listingCard,
      "Artificial Intelligence",
      [
        ["AI", listing.usesAI],
