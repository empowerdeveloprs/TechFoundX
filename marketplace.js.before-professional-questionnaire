  if (listing.revenueStatus === "Yes") {

    addListingSection(
      listingCard,
      "Performance",
      [
        ["Revenue Status", listing.revenueStatus],
        ["Monthly Revenue", listing.monthlyRevenue],
        ["Annual Revenue", listing.annualRevenue],
        ["Paying Customers", listing.customers],
        ["Active Users", listing.activeUsers]
