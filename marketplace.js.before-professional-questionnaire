  function createQuestion(question, required = false) {

    const wrapper = document.createElement("div");
    wrapper.className = "market-question";

    const label = document.createElement("label");
    label.htmlFor = question.id;
    label.innerHTML =
      question.label +
      (required ? ' <span class="required">*</span>' : '');

    wrapper.appendChild(label);

    let field;

    if (question.type === "select") {

      field = document.createElement("select");

      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "Select an option";
      field.appendChild(placeholder);

      question.options.forEach(option => {
        const item = document.createElement("option");
        item.value = option;
        item.textContent = option;
        field.appendChild(item);
      });

    } else if (question.type === "textarea") {

      field = document.createElement("textarea");
      field.placeholder = question.placeholder || "";

    } else {

      field = document.createElement("input");
      field.type = question.type || "text";
      field.placeholder = question.placeholder || "";
    }

    field.id = question.id;
    field.name = question.id;

    field.addEventListener("input", () => {
      state.answers[question.id] = field.value;
    });

    field.addEventListener("change", () => {
      state.answers[question.id] = field.value;
    });

    wrapper.appendChild(field);

    return wrapper;
  }


  function renderQuestions(purpose) {

    const set = questionSets[purpose];

    if (!set) return;

    questionArea.innerHTML = "";

    const form = document.createElement("form");
    form.id = "purpose-question-form";

    const compulsoryTitle = document.createElement("h3");
    compulsoryTitle.textContent = "Compulsory Information";
    form.appendChild(compulsoryTitle);

    set.compulsory.forEach(question => {
      form.appendChild(createQuestion(question, true));
    });


    if (set.supplementary.length) {

      const supplementaryTitle = document.createElement("h3");
      supplementaryTitle.textContent = "Supplementary Information";

      form.appendChild(supplementaryTitle);

      set.supplementary.forEach(question => {
        form.appendChild(createQuestion(question, false));
      });
    }


    const actions = document.createElement("div");
    actions.className = "question-actions";

    const continueButton = document.createElement("button");
    continueButton.type = "submit";
    continueButton.textContent = "Continue";

    actions.appendChild(continueButton);
    form.appendChild(actions);

    form.addEventListener("submit", event => {

      event.preventDefault();

      const missing = set.compulsory.find(question => {
        return !state.answers[question.id];
      });

      if (missing) {

        const field = document.getElementById(missing.id);

        if (field) {
          field.focus();
        }

        alert("Please complete all compulsory information.");
        return;
      }

      purposeResult.hidden = false;

      purposeResult.querySelector("h3").textContent =
        purpose === "seller"
          ? "Your technology profile is ready for the next stage."
          : "Your marketplace experience is ready for the next stage.";

      purposeResult.querySelector("p").textContent =
        purpose === "seller"
          ? "The information you provide will be used to progressively build your technology listing and present the appropriate marketplace facilities."
          : "The information you provide will be used to focus the marketplace experience on your selected purpose.";

      purposeResult.scrollIntoView({
        behavior: "smooth",
        block: "start"
      });

    });

    questionArea.appendChild(form);
  }


  purposeButtons.forEach(button => {

    button.addEventListener("click", () => {

