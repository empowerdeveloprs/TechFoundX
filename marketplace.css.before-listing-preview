:root {
  --mp-navy: #062b52;
  --mp-blue: #eaf2f8;
  --mp-light: #f6f9fb;
  --mp-white: #ffffff;
  --mp-gold: #9a6a12;
  --mp-text: #24384d;
  --mp-muted: #667789;
  --mp-border: rgba(6, 43, 82, 0.11);
  --mp-shadow: 0 18px 50px rgba(6, 43, 82, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--mp-text);
  font-family: Arial, Helvetica, sans-serif;
  background:
    radial-gradient(circle at 10% 10%, rgba(255,255,255,.95), transparent 28%),
    radial-gradient(circle at 90% 80%, rgba(224,237,246,.8), transparent 30%),
    var(--mp-light);
}

a {
  color: inherit;
  text-decoration: none;
}

.market-header {
  position: sticky;
  top: 0;
  z-index: 20;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;

  min-height: 76px;
  padding: 12px 6%;

  background: rgba(255,255,255,.94);
  border-bottom: 1px solid var(--mp-border);
  box-shadow: 0 5px 25px rgba(6,43,82,.06);
  backdrop-filter: blur(12px);
}

.market-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.market-brand img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.market-brand strong,
.market-brand span {
  display: block;
}

.market-brand strong {
  color: var(--mp-navy);
  font-size: 21px;
}

.market-brand span {
  margin-top: 4px;
  color: var(--mp-muted);
  font-size: 11px;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.market-header nav {
  display: flex;
  gap: 25px;
}

.market-header nav a {
  color: var(--mp-navy);
  font-size: 14px;
  font-weight: 700;
}

.market-header nav a:hover {
  color: var(--mp-gold);
}

main {
  width: min(1240px, 92%);
  margin: auto;
}

.market-welcome {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  gap: 35px;
  align-items: center;

  min-height: 650px;
  padding: 70px 0;
}

.welcome-copy {
  padding: 25px;
}

.eyebrow,
.section-title span {
  color: var(--mp-gold);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .15em;
}

.welcome-copy h1 {
  margin: 18px 0;
  color: var(--mp-navy);
  font-size: clamp(42px, 6vw, 72px);
  line-height: 1.02;
}

.welcome-copy h1 span {
  display: block;
  color: var(--mp-gold);
}

.welcome-copy p {
  max-width: 620px;
  color: var(--mp-muted);
  font-size: 18px;
  line-height: 1.8;
}

.purpose-card {
  padding: 38px;

  background: rgba(255,255,255,.94);
  border: 1px solid var(--mp-border);
  border-radius: 26px;
  box-shadow: var(--mp-shadow);
}

.purpose-card h2 {
  margin: 12px 0 10px;
  color: var(--mp-navy);
  font-size: 31px;
}

.purpose-card > p {
  color: var(--mp-muted);
  line-height: 1.7;
}

.purpose-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 13px;
  margin-top: 25px;
}

.purpose-grid button {
  min-height: 145px;
  padding: 20px;

  text-align: left;
  cursor: pointer;

  background: var(--mp-white);
  color: var(--mp-navy);

  border: 1px solid var(--mp-border);
  border-radius: 16px;

  transition: transform .2s ease,
              border-color .2s ease,
              box-shadow .2s ease;
}

.purpose-grid button:last-child {
  grid-column: 1 / -1;
}

.purpose-grid button:hover {
  transform: translateY(-3px);
  border-color: rgba(154,106,18,.45);
  box-shadow: 0 12px 30px rgba(6,43,82,.09);
}

.purpose-grid strong,
.purpose-grid span {
  display: block;
}

.purpose-grid strong {
  margin-bottom: 9px;
  font-size: 17px;
}

.purpose-grid span {
  color: var(--mp-muted);
  font-size: 13px;
  line-height: 1.55;
}

.products-preview,
.categories {
  padding: 75px 0;
}

.section-title {
  margin-bottom: 28px;
}

.section-title h2 {
  margin: 10px 0 0;
  color: var(--mp-navy);
  font-size: 38px;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22px;
}

.product-card {
  padding: 32px;

  background: var(--mp-white);
  border: 1px solid var(--mp-border);
  border-radius: 22px;
  box-shadow: var(--mp-shadow);
}

.product-label {
  color: var(--mp-gold);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .13em;
}

.product-card h3 {
  margin: 12px 0;
  color: var(--mp-navy);
  font-size: 28px;
}

.product-card p {
  color: var(--mp-muted);
  line-height: 1.7;
}

.product-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: 25px;
}

.product-actions a {
  padding: 11px 17px;
  border-radius: 10px;
  background: var(--mp-navy);
  color: white;
  font-size: 13px;
  font-weight: 700;
}

.product-actions span {
  color: var(--mp-gold);
  font-size: 12px;
  font-weight: 700;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.category-grid span {
  padding: 20px;
  text-align: center;

  background: #eaf2f8;
  border: 1px solid var(--mp-border);
  border-radius: 14px;

  color: var(--mp-navy);
  font-weight: 700;
}

.market-footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;

  margin-top: 50px;
  padding: 35px 6%;

  background: var(--mp-navy);
  color: white;
}

.market-footer span {
  color: rgba(255,255,255,.72);
}

@media (max-width: 850px) {
  .market-header {
    padding: 12px 4%;
  }

  .market-header nav {
    display: none;
  }

  .market-welcome {
    grid-template-columns: 1fr;
    padding: 45px 0;
  }

  .welcome-copy {
    padding: 10px 5px;
  }

  .product-grid {
    grid-template-columns: 1fr;
  }

  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 520px) {
  main {
    width: 94%;
  }

  .market-welcome {
    min-height: auto;
  }

  .purpose-card {
    padding: 23px;
    border-radius: 19px;
  }

  .purpose-grid {
    grid-template-columns: 1fr;
  }

  .purpose-grid button:last-child {
    grid-column: auto;
  }

  .welcome-copy h1 {
    font-size: 43px;
  }

  .category-grid {
    grid-template-columns: 1fr;
  }

  .product-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .market-footer {
    flex-direction: column;
  }
}

/* PURPOSE QUESTION EXPERIENCE */

.purpose-flow {
  padding: 80px 0;
}

.purpose-flow .section-title p {
  max-width: 760px;
  color: var(--mp-muted);
  line-height: 1.7;
}

.question-area {
  max-width: 900px;
}

#purpose-question-form {
  padding: 32px;
  background: var(--mp-white);
  border: 1px solid var(--mp-border);
  border-radius: 22px;
  box-shadow: var(--mp-shadow);
}

#purpose-question-form h3 {
  margin: 8px 0 22px;
  color: var(--mp-navy);
  font-size: 20px;
}

#purpose-question-form h3:not(:first-child) {
  margin-top: 40px;
  padding-top: 30px;
  border-top: 1px solid var(--mp-border);
}

.market-question {
  margin-bottom: 22px;
}

.market-question label {
  display: block;
  margin-bottom: 8px;
  color: var(--mp-navy);
  font-size: 14px;
  font-weight: 700;
}

.market-question .required {
  color: var(--mp-gold);
}

.market-question input,
.market-question select,
.market-question textarea {
  width: 100%;
  padding: 13px 14px;

  border: 1px solid var(--mp-border);
  border-radius: 10px;

  background: #fbfdff;
  color: var(--mp-text);

  font: inherit;
}

.market-question textarea {
  min-height: 110px;
  resize: vertical;
}

.market-question input:focus,
.market-question select:focus,
.market-question textarea:focus {
  outline: none;
  border-color: var(--mp-gold);
  box-shadow: 0 0 0 3px rgba(154,106,18,.09);
}

.question-actions {
  margin-top: 30px;
}

.question-actions button {
  padding: 13px 24px;

  border: 0;
  border-radius: 10px;

  background: var(--mp-navy);
  color: white;

  cursor: pointer;
  font-weight: 700;
}

.question-actions button:hover {
  background: #0a3c70;
}

.purpose-result {
  max-width: 900px;
  margin-top: 25px;
  padding: 30px;

  background: #eef5f9;
  border: 1px solid var(--mp-border);
  border-radius: 18px;
}

.purpose-result h3 {
  margin-top: 0;
  color: var(--mp-navy);
}

.purpose-result p {
  margin-bottom: 0;
  color: var(--mp-muted);
  line-height: 1.7;
}

@media (max-width: 600px) {

  #purpose-question-form {
    padding: 22px;
  }

  .purpose-flow {
    padding: 55px 0;
  }
}
