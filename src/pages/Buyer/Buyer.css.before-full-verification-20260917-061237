.buyer-page {
  min-height: 70vh;
  padding: 70px 24px 100px;
  background: var(--off-white);
}

.buyer-header {
  max-width: 920px;
  margin: 0 auto 36px;
}

.buyer-header h1 {
  margin: 10px 0 14px;
  color: var(--navy-dark);
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1.1;
}

.buyer-header > p {
  max-width: 800px;
  color: var(--muted);
  line-height: 1.7;
}

.buyer-progress {
  margin-top: 28px;
  padding: 18px;
  background: var(--white);
  border: 1px solid var(--border);
}

.buyer-progress-top {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 10px;
  color: var(--navy);
  font-size: 0.85rem;
  font-weight: 750;
}

.buyer-progress-track {
  height: 8px;
  overflow: hidden;
  background: #e9e4da;
}

.buyer-progress-fill {
  height: 100%;
  background: var(--gold);
  transition: width 180ms ease;
}

.buyer-form {
  max-width: 920px;
  margin: 0 auto;
}

.buyer-section {
  margin-bottom: 22px;
  padding: 30px;
  background: var(--white);
  border: 1px solid var(--border);
  box-shadow: 0 10px 30px rgba(16, 42, 67, 0.05);
}

.buyer-section-heading {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--border);
}

.buyer-section-number {
  flex: 0 0 auto;
  color: var(--gold);
  font-size: 0.75rem;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.buyer-section-heading h2 {
  margin: 0 0 7px;
  color: var(--navy);
  font-size: 1.35rem;
}

.buyer-section-heading p {
  margin: 0;
  color: var(--muted);
  line-height: 1.55;
}

.buyer-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  padding-top: 24px;
}

.buyer-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--navy);
}

.buyer-field:has(textarea),
.buyer-field:has(.buyer-checkbox) {
  grid-column: 1 / -1;
}

.buyer-label {
  font-size: 0.88rem;
  font-weight: 780;
}

.buyer-required {
  color: var(--gold);
}

.buyer-description {
  color: var(--muted);
  font-size: 0.76rem;
  line-height: 1.45;
}

.buyer-field input:not([type='checkbox']),
.buyer-field select,
.buyer-field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 13px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: #fff;
  color: var(--navy);
  font: inherit;
}

.buyer-field textarea {
  resize: vertical;
}

.buyer-field input:focus,
.buyer-field select:focus,
.buyer-field textarea:focus {
  outline: 2px solid rgba(198, 154, 74, 0.28);
  border-color: var(--gold);
}

.buyer-checkbox {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px;
  background: #faf8f3;
  border: 1px solid var(--border);
  line-height: 1.5;
}

.buyer-checkbox input {
  margin-top: 3px;
  accent-color: var(--gold);
}

.buyer-success {
  margin: 24px 0;
  padding: 18px;
  border-left: 4px solid var(--gold);
  background: #faf7f0;
  color: var(--navy);
}

.buyer-success p {
  margin: 7px 0 0;
  color: var(--muted);
  line-height: 1.55;
}

.buyer-actions {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding-top: 8px;
}

@media (max-width: 680px) {
  .buyer-page {
    padding: 48px 16px 70px;
  }

  .buyer-section {
    padding: 22px;
  }

  .buyer-fields {
    grid-template-columns: 1fr;
  }

  .buyer-field:has(textarea),
  .buyer-field:has(.buyer-checkbox) {
    grid-column: auto;
  }

  .buyer-actions {
    flex-direction: column;
  }

  .buyer-actions .button {
    width: 100%;
  }
}
