/* =========================================================
   TECH FOUNDX — LUXURY HEADER
   ========================================================= */

.luxury-header {
  position: relative;
  isolation: isolate;
  min-height: 92px;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: minmax(190px, 1fr) auto minmax(110px, 1fr);
  align-items: center;
  gap: 28px;
  padding: 10px clamp(18px, 4vw, 52px);
  overflow: hidden;
  background:
    linear-gradient(
      90deg,
      rgba(4, 16, 29, 0.96),
      rgba(8, 28, 47, 0.86) 48%,
      rgba(4, 16, 29, 0.95)
    ),
    url("/assets/branding/header-bg.png") center / cover no-repeat;
  border-bottom: 1px solid rgba(198, 154, 74, 0.42);
  box-shadow:
    0 10px 35px rgba(0, 0, 0, 0.24),
    inset 0 -1px 0 rgba(255, 255, 255, 0.05);
}

.luxury-header::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(198, 154, 74, 0.16),
      transparent 48%
    ),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.025),
      transparent 65%
    );
  pointer-events: none;
}

.luxury-header-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: rgba(4, 16, 29, 0.28);
  pointer-events: none;
}

.luxury-brand {
  position: relative;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-width: 0;
  text-decoration: none;
}

.luxury-logo {
  display: block;
  width: min(245px, 100%);
  height: auto;
  max-height: 70px;
  object-fit: contain;
  object-position: left center;
  filter:
    drop-shadow(0 5px 14px rgba(0, 0, 0, 0.38))
    drop-shadow(0 0 10px rgba(198, 154, 74, 0.08));
}

.luxury-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(14px, 2.4vw, 30px);
}

.luxury-nav a {
  position: relative;
  padding: 9px 2px;
  color: #f3eee5;
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.035em;
  text-decoration: none;
  white-space: nowrap;
  transition:
    color 180ms ease,
    transform 180ms ease;
}

.luxury-nav a::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 2px;
  left: 0;
  height: 1px;
  background: #c69a4a;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 180ms ease;
}

.luxury-nav a:hover,
.luxury-nav a:focus-visible {
  color: #d8ad5b;
  transform: translateY(-1px);
}

.luxury-nav a:hover::after,
.luxury-nav a:focus-visible::after {
  transform: scaleX(1);
}

.luxury-login {
  position: relative;
  z-index: 2;
  justify-self: end;
  min-width: 88px;
  box-sizing: border-box;
  padding: 10px 18px;
  border: 1px solid rgba(214, 174, 91, 0.8);
  border-radius: 4px;
  color: #fffaf0;
  background:
    linear-gradient(
      135deg,
      rgba(198, 154, 74, 0.26),
      rgba(198, 154, 74, 0.08)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.1),
    0 5px 18px rgba(0, 0, 0, 0.18);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-align: center;
  text-decoration: none;
  transition:
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

.luxury-login:hover,
.luxury-login:focus-visible {
  border-color: #e0bb6a;
  background: rgba(198, 154, 74, 0.24);
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.12),
    0 7px 22px rgba(0, 0, 0, 0.24);
}

@media (max-width: 900px) {
  .luxury-header {
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "brand login"
      "nav nav";
    gap: 8px 16px;
    padding: 10px 18px 11px;
  }

  .luxury-brand {
    grid-area: brand;
  }

  .luxury-logo {
