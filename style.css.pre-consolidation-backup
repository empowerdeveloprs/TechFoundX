    0 1px 2px rgba(255,255,255,0.65);
}

.hero p {
  color: #45656d;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.section-heading h2 {
  color: #183943;
}

.section-heading span {
  color: #237f8d;
}


/* =========================================================
   LIGHT GLASS CARDS
   ========================================================= */

.card,
.capability-card,
.value-card {
  background:
    linear-gradient(
      135deg,
      rgba(246,253,253,0.84),
      rgba(205,232,235,0.72)
    );

  border-color:
    rgba(52,123,136,0.18);

  box-shadow:
    0 10px 30px rgba(31,93,107,0.10),
    inset 0 1px 0 rgba(255,255,255,0.70);
}

.card:hover,
.capability-card:hover,
.value-card:hover {
  border-color:
    rgba(43,135,148,0.35);

  box-shadow:
    0 14px 34px rgba(31,93,107,0.15),
    inset 0 1px 0 rgba(255,255,255,0.82);
}


/* =========================================================
   HIBBA
   ========================================================= */

.hibha-section {
  background:
    linear-gradient(
      135deg,
      rgba(229,247,246,0.42),
      rgba(180,220,224,0.28)
    );
}

.hibha-card {
  background:
    linear-gradient(
      135deg,
      rgba(31,83,91,0.94),
      rgba(10,48,61,0.97)
    );

  box-shadow:
    0 15px 38px rgba(12,59,72,0.20),
    inset 0 1px 0 rgba(255,255,255,0.10);
}


/* =========================================================
   CONTACT
   ========================================================= */

.contact {
  background:
    linear-gradient(
      135deg,
      rgba(232,248,249,0.76),
      rgba(193,226,230,0.60)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.65);
}


/* =========================================================
   FOOTER
   ========================================================= */

footer {
  background:
    linear-gradient(
      90deg,
      rgba(12,49,61,0.92),
      rgba(5,35,49,0.98)
    );

  box-shadow:
    inset 0 1px 0 rgba(133,213,216,0.15);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 700px) {

  body {
    background-size:
      100% 100%,
      90% 70%,
      85% 70%,
      220px 220px;
  }

  .site-header {
    background-size:
      100% 100%,
      220px 220px,
      100% 100%;
  }

  .brand-text strong {
    font-size: 20px;
    word-spacing: 5px;
  }

}


