  --header-dark: #134E5E;
  --header-green: #71B280;
  --header-light: #C7EFCF;

  --background-blue: #2193B0;
  --background-cyan: #6DD5ED;
  --background-light: #B2FEFA;

  --clean-text: #123B50;
