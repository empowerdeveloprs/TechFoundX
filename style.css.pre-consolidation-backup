/* =========================================================
   EMPOWERDEVELOPERS — DARK / LIGHT GREEN CORPORATE THEME
   ========================================================= */

:root {
  --bg: #12231f;
  --surface: #19302a;
  --surface-light: #234139;

  --text: #edf5f1;
  --muted: #b8cbc4;

  --accent: #8fc9ad;
  --accent-light: #c8e5d8;

  --border: rgba(200, 229, 216, 0.14);
}

/* PAGE */

body {
  background:
    radial-gradient(
      circle at 15% 15%,
      rgba(91, 145, 122, 0.14),
      transparent 35%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(74, 119, 101, 0.12),
      transparent 38%
    ),
    var(--bg);

  color: var(--text);
}

/* HEADER */

.site-header {
  background: rgba(18, 35, 31, 0.94);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--text);
  text-decoration: none;
}

.header-logo {
  width: 46px;
  height: 46px;
  object-fit: contain;
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.brand-text strong {
  color: var(--text);
  font-size: 18px;
}

.brand-text span {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.3;
}

/* NAVIGATION */

.site-nav a {
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.site-nav a:hover {
  color: var(--accent-light);
}

/* SECTIONS */

.section {
  background: transparent;
}

.section-heading span {
  color: var(--accent);
}

.section-heading h2 {
  color: var(--text);
}

/* CARDS */

.card,
.capability-card,
.value-card {
  background: rgba(25, 48, 42, 0.88);
  border-color: var(--border);
}

.card:hover,
.capability-card:hover,
.value-card:hover {
  border-color: rgba(143, 201, 173, 0.30);
}

/* HERO */

.hero {
  background:
    linear-gradient(
      135deg,
      rgba(35, 65, 57, 0.72),
      rgba(18, 35, 31, 0.90)
    );
}

.hero h1 {
  color: var(--text);
}

.hero p {
  color: var(--muted);
}

/* LINKS / BUTTONS */

a {
  color: var(--accent);
}

button,
.btn,
.primary-button {
  background: var(--accent);
  color: #12231f;
}

button:hover,
.btn:hover,
.primary-button:hover {
  background: var(--accent-light);
}

/* HIBBA */

.hibha-section {
  background:
    linear-gradient(
      180deg,
      rgba(35, 65, 57, 0.30),
      rgba(18, 35, 31, 0.15)
    );
}

.hibha-card {
  background:
    linear-gradient(
      135deg,
      rgba(31, 59, 51, 0.96),
      rgba(23, 45, 39, 0.96)
    );

  border-color: var(--border);
  box-shadow:
    0 12px 35px rgba(0, 0, 0, 0.18);
}

.hibha-logo-wrap {
  background: #f4f8f5;
  border-color: rgba(200, 229, 216, 0.18);
}

.hibha-kicker {
  color: var(--accent-light);
}

.hibha-content h3 {
  color: var(--text);
}

.hibha-content p {
  color: var(--muted);
}

/* HIBBA SERVICE CARDS */

.hibha-service {
  background: rgba(244, 248, 245, 0.96);
  border-color: rgba(200, 229, 216, 0.16);
}

.hibha-service strong {
  color: #20352e;
}

.hibha-service small {
  color: #60736b;
}

.hibha-service:hover {
  box-shadow:
    0 8px 22px rgba(0, 0, 0, 0.16);
}

/* HIBBA MISSION */

.hibha-mission {
  background: rgba(143, 201, 173, 0.10);
  border-left-color: var(--accent);
}

.hibha-mission strong {
  color: var(--text);
}

.hibha-mission p {
  color: var(--muted);
}

/* CONTACT */

.contact {
  background: rgba(25, 48, 42, 0.55);
}

.contact a {
  color: var(--accent-light);
}

/* FOOTER */

footer {
  background: rgba(10, 22, 19, 0.55);
  border-top-color: var(--border);
  color: var(--muted);
}

/* MOBILE HEADER */

@media (max-width: 700px) {

  .brand-text span {
    font-size: 10px;
  }

  .header-logo {
    width: 40px;
    height: 40px;
  }

  .brand-text strong {
    font-size: 16px;
  }

}

