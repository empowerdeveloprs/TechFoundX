:root {
  --bg: #06111f;
  --surface: #0b1b2d;
  --surface-light: #10263d;
  --text: #f5f7fa;
  --muted: #aab8c8;
  --accent: #55d9ff;
  --border: rgba(255,255,255,0.10);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}


/* HEADER */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  min-height: 76px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 12px 7%;

  background: rgba(6,17,31,0.94);
  backdrop-filter: blur(14px);

  border-bottom: 1px solid var(--border);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;

  font-size: 20px;
  font-weight: 700;
}

.brand img {
  width: 48px;
  height: 48px;

  object-fit: contain;
  display: block;
}

nav {
  display: flex;
  gap: 28px;
}

nav a {
  color: var(--muted);
  font-size: 14px;
  transition: 0.2s ease;
}

nav a:hover {
  color: var(--text);
}


/* HERO */

.hero {
  min-height: 88vh;

  display: flex;
  align-items: center;

  padding: 90px 7%;

  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(85,217,255,0.13),
      transparent 35%
    ),
    radial-gradient(
      circle at 15% 70%,
      rgba(85,217,255,0.08),
      transparent 30%
    );
}

.hero-content {
  max-width: 900px;
}

.eyebrow {
  color: var(--accent);
  font-size: 12px;
  letter-spacing: 3px;
  margin-bottom: 22px;
}

h1 {
  font-size: clamp(44px, 7vw, 82px);
  line-height: 1.04;
  margin-bottom: 30px;
}

.hero-lead {
  max-width: 760px;
  color: var(--muted);
  font-size: 19px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  margin-top: 36px;
  flex-wrap: wrap;
}

.button {
  padding: 13px 23px;
  border-radius: 8px;
  font-weight: 700;
  border: 1px solid var(--border);
}

.primary {
  background: var(--accent);
  color: #06111f;
}

.secondary {
  background: transparent;
}


/* SECTIONS */

.section {
  padding: 100px 7%;
  border-top: 1px solid var(--border);
}

.section-heading {
  display: flex;
  gap: 18px;
  align-items: baseline;
  margin-bottom: 45px;
}

.section-heading span {
  color: var(--accent);
  font-size: 13px;
  letter-spacing: 2px;
}

.section-heading h2 {
  font-size: clamp(30px, 5vw, 48px);
}


/* MISSION */

.mission-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 30px;
}

.mission-main,
.mission-statement {
  padding: 35px;

  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
}

.mission-main h3 {
  font-size: 30px;
  line-height: 1.3;
  margin-bottom: 24px;
}

.mission-main p {
  color: var(--muted);
}

.mission-main p + p {
  margin-top: 18px;
}

.mission-statement {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mission-statement span {
  color: var(--accent);
  font-size: 12px;
  letter-spacing: 3px;
  margin-bottom: 20px;
}

.mission-statement strong {
  font-size: 30px;
  line-height: 1.35;
}


/* CARDS */

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.card {
  padding: 30px;
  min-height: 240px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: 16px;

  transition: transform 0.2s ease, border-color 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: rgba(85,217,255,0.35);
}

.card-number {
  color: var(--accent);
  font-size: 13px;
  margin-bottom: 24px;
}

.card h3 {
  margin-bottom: 12px;
  font-size: 22px;
}

.card p {
  color: var(--muted);
}


/* APPROACH */

.approach {
  background: var(--surface);
}

.approach-content {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 50px;
  align-items: center;
}

.approach-content h2 {
  font-size: clamp(36px, 5vw, 62px);
  line-height: 1.1;
}

.approach-content p {
  color: var(--muted);
  font-size: 18px;
}


/* VALUES */

.values {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.values > div {
  padding: 25px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: 14px;
}

.values strong {
  display: block;
  font-size: 20px;
  margin-bottom: 10px;
}

.values p {
  color: var(--muted);
}


/* FUTURE */

.future {
  text-align: center;
  background:
    radial-gradient(
      circle at center,
      rgba(85,217,255,0.10),
      transparent 55%
    );
}

.future-content {
  max-width: 850px;
  margin: auto;
}

.future-content > span {
  color: var(--accent);
  font-size: 12px;
  letter-spacing: 3px;
}

.future-content h2 {
  font-size: clamp(38px, 6vw, 68px);
  line-height: 1.1;
  margin: 18px 0;
}

.future-content p {
  color: var(--muted);
  font-size: 18px;
}


/* CONTACT */

.contact-card {
  display: flex;
  align-items: center;
  gap: 25px;

  max-width: 850px;

  padding: 32px;

  background: var(--surface);

  border: 1px solid var(--border);
  border-radius: 16px;
}

.contact-logo {
  width: 76px;
  height: 76px;
  object-fit: contain;
  flex-shrink: 0;
}

.contact-card h3 {
  font-size: 25px;
}

.contact-card p {
  color: var(--muted);
}

.contact-card a {
  display: inline-block;
  margin-top: 10px;
  color: var(--accent);
}


/* FOOTER */

footer {
  padding: 35px 7%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 20px;
  flex-wrap: wrap;

  border-top: 1px solid var(--border);

  color: var(--muted);
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.footer-brand img {
  width: 38px;
  height: 38px;
  object-fit: contain;
}

.footer-brand div {
  display: flex;
  flex-direction: column;
}

.footer-brand strong {
  color: var(--text);
}

.footer-brand span {
  font-size: 13px;
}

footer p {
  font-size: 13px;
}


/* MOBILE */

@media (max-width: 850px) {

  .site-header {
    padding: 10px 5%;
  }

  .brand img {
    width: 44px;
    height: 44px;
  }

  nav {
    display: none;
  }

  .hero,
  .section {
    padding-left: 5%;
    padding-right: 5%;
  }

  .mission-grid,
  .approach-content {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .values {
    grid-template-columns: 1fr 1fr;
  }

  h1 {
    font-size: 48px;
  }

  .hero-lead {
    font-size: 17px;
  }

  .contact-card {
    align-items: flex-start;
  }
}


@media (max-width: 500px) {

  .values {
    grid-template-columns: 1fr;
  }

  .contact-card {
    flex-direction: column;
  }

  .mission-main h3 {
    font-size: 25px;
  }

}


