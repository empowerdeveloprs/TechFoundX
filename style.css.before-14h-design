/* =========================================================
   HEADER + FOOTER
   STRONG TURQUOISE + BLUE FLORAL/AJRAK PATTERN
   ========================================================= */

.site-header {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      #08b9b0 0%,
      #10c8bd 50%,
      #06aaa9 100%
    );
  border-bottom: 2px solid rgba(5, 72, 112, 0.28);
}

/* Blue floral / Ajrak pattern */
.site-header::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    linear-gradient(
      90deg,
      rgba(8, 185, 176, 0.84),
      rgba(16, 200, 189, 0.72),
      rgba(6, 170, 169, 0.84)
    ),
    url("assets/ajrak-header-pattern.svg") center / 300px auto repeat;
  content: "";
  opacity: 0.95;
  pointer-events: none;
}

/* Keep header content above the pattern */
.site-header > * {
  position: relative;
  z-index: 1;
}

/* =========================================================
   FOOTER
   ========================================================= */

.site-footer {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      #07aaa7 0%,
      #12c2b8 50%,
      #069f9f 100%
    );
  border-top: 2px solid rgba(5, 72, 112, 0.28);
}

/* Blue floral / Ajrak pattern */
.site-footer::before {
  position: absolute;
  inset: 0;
  z-index: 0;
  background:
    linear-gradient(
      90deg,
      rgba(7, 170, 167, 0.86),
      rgba(18, 194, 184, 0.72),
      rgba(6, 159, 159, 0.86)
    ),
    url("assets/ajrak-header-pattern.svg") center / 300px auto repeat;
  content: "";
  opacity: 0.95;
  pointer-events: none;
}

/* Keep footer content above the pattern */
.site-footer > * {
  position: relative;
  z-index: 1;
}

/* Footer text — white for strong contrast */
