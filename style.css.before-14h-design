}

.guardian-section .guardian-verified {
  margin-top: 30px;
  background: rgba(255,255,255,.055);
  border-color: rgba(255,255,255,.12);
}

.guardian-section .guardian-verification-grid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 12px;
}

.guardian-section .guardian-verification-grid > * {
  min-height: 76px;
  padding: 15px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 12px;
  background: rgba(255,255,255,.035);
}

.guardian-section .guardian-verification-grid strong {
  display: block;
  margin-bottom: 6px;
  color: #35d4bd !important;
  font-size: 1.05rem;
}

.guardian-section .guardian-verification-grid span {
  display: block;
  color: rgba(255,255,255,.7) !important;
  font-size: .78rem;
  line-height: 1.4;
}

.guardian-section .guardian-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 30px;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,.1);
}

.guardian-section .guardian-status {
  margin: 0;
  color: #35d4bd !important;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .09em;
}

.guardian-section .guardian-footer .button {
  flex-shrink: 0;
}


/* Guardian-Core mobile */

@media (max-width: 900px) {
  .guardian-section .guardian-capabilities,
  .guardian-commercial-grid {
    grid-template-columns: 1fr;
  }

  .guardian-security-grid,
  .guardian-section .guardian-verification-grid {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media (max-width: 720px) {
  .guardian-card {
    grid-template-columns: 1fr;
    padding: 28px 22px;
    gap: 20px;
  }

  .guardian-icon {
    width: 62px;
    height: 62px;
  }

  .guardian-security-grid,
  .guardian-section .guardian-verification-grid {
    grid-template-columns: 1fr;
  }

  .guardian-security-model,
  .guardian-emergency,
  .guardian-commercial,
  .guardian-section .guardian-verified {
    padding: 20px;
  }

  .guardian-section .guardian-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .guardian-section .guardian-footer .button {
    width: 100%;
    text-align: center;
  }
}

