/* =========================================================
   EmpowerDevelopers — Consolidated Corporate Stylesheet
   Production foundation
   ========================================================= */

:root {
  --navy-950: #06111f;
  --navy-900: #0a1728;
  --navy-800: #10243a;
  --navy-700: #18344f;

  --teal-500: #18b7a0;
  --teal-400: #36d4bd;
  --teal-soft: rgba(24, 183, 160, 0.12);

  --gold-500: #d6ad55;
  --gold-soft: rgba(214, 173, 85, 0.14);

  --white: #ffffff;
  --surface: #f5f8fa;
  --surface-alt: #edf3f6;
  --text: #102033;
  --text-soft: #536579;
  --border: rgba(16, 32, 51, 0.11);

  --shadow-sm: 0 8px 24px rgba(6, 17, 31, 0.07);
  --shadow-md: 0 18px 48px rgba(6, 17, 31, 0.11);
  --shadow-lg: 0 28px 70px rgba(6, 17, 31, 0.16);

  --radius-sm: 10px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;

  --container: 1180px;
  --header-height: 76px;

  --font-sans:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  --transition: 180ms ease;

  /* Brand-safe theme refinement */
--theme-blue-gray: #dce7f2;
  --theme-lavender: #e9e5f1;
  --theme-sage: #e2eee9;
  --logo-safe: #f1f3f5;

  --accent-teal: #168f82;
  --accent-teal-soft: rgba(22, 143, 130, 0.12);

  --surface-border: rgba(16, 32, 51, 0.10);
  --section-shadow: 0 10px 35px rgba(16, 32, 51, 0.045);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-height) + 20px);
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--white);
  color: var(--text);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

::selection {
  background: rgba(24, 183, 160, 0.2);
  color: var(--navy-950);
}

/* =========================================================
   Accessibility
   ========================================================= */

:focus-visible {
  outline: 3px solid var(--teal-400);
  outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* =========================================================
   Shared layout
   ========================================================= */

.section {
  position: relative;
  width: min(100% - 40px, var(--container));
  margin: 0 auto;
  padding: 96px 0;
}

.section-heading {
  max-width: 760px;
  margin: 0 auto 52px;
  text-align: center;
}

.section-heading h2 {
  margin: 10px 0 16px;
  color: var(--navy-950);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.12;
  letter-spacing: -0.035em;
}

.section-heading p {
  margin: 0;
  color: var(--text-soft);
  font-size: 1.05rem;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin: 0;
  color: var(--teal-500);
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  line-height: 1.3;
  text-transform: uppercase;
}

.eyebrow::before {
  width: 22px;
  height: 2px;
  border-radius: 999px;
  background: currentColor;
  content: "";
}

.button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  padding: 12px 22px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 0.94rem;
  font-weight: 750;
  line-height: 1;
  text-decoration: none;
  transition:
    transform var(--transition),
    background-color var(--transition),
    border-color var(--transition),
    color var(--transition),
    box-shadow var(--transition);
}

.button:hover {
  transform: translateY(-2px);
}

.button.primary {
  background: var(--teal-500);
  color: var(--white);
  box-shadow: 0 10px 24px rgba(24, 183, 160, 0.2);
}

.button.primary:hover {
  background: #139f8b;
  box-shadow: 0 14px 30px rgba(24, 183, 160, 0.28);
}

.button.secondary {
  border-color: rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.06);
  color: var(--white);
}

.button.secondary:hover {
  border-color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.12);
}

/* =========================================================
   Header
   ========================================================= */

.site-header {
  position: sticky;
  z-index: 100;
  top: 0;
  min-height: var(--header-height);
  border-bottom: 1px solid rgba(16, 32, 51, 0.08);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4px 20px rgba(6, 17, 31, 0.05);
  backdrop-filter: blur(16px);
}

.header-brand {
  width: min(100% - 40px, var(--container));
  min-height: var(--header-height);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand-link {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 12px;
  color: var(--navy-950);
  text-decoration: none;
}

.header-logo {
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  object-fit: contain;
}

.brand-text {
  min-width: 0;
}

.brand-text strong,
.brand-text span {
  display: block;
}

.brand-text strong {
  font-size: 1rem;
  font-weight: 850;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.brand-text span {
  margin-top: 3px;
  color: var(--text-soft);
  font-size: 0.68rem;
  font-weight: 600;
  line-height: 1.2;
}

.site-nav {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}

.site-nav a {
  position: relative;
  padding: 9px 11px;
  border-radius: 8px;
  color: var(--text-soft);
  font-size: 0.84rem;
  font-weight: 700;
  text-decoration: none;
  transition:
    color var(--transition),
    background-color var(--transition);
}

.site-nav a:hover {
  background: var(--surface);
  color: var(--navy-950);
}

/* =========================================================
   Hero
   ========================================================= */

.hero {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  min-height: 650px;
  display: flex;
  align-items: center;
  background:
    radial-gradient(circle at 85% 15%, rgba(24, 183, 160, 0.18), transparent 30%),
    radial-gradient(circle at 10% 90%, rgba(214, 173, 85, 0.1), transparent 28%),
    linear-gradient(135deg, var(--navy-950), var(--navy-900) 58%, #0c263b);
  color: var(--white);
}

.hero::before {
  position: absolute;
  z-index: -1;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(6, 17, 31, 0.98), rgba(6, 17, 31, 0.72) 58%, rgba(6, 17, 31, 0.28)),
    url("assets/sky-background-pattern.svg") center / cover no-repeat;
  content: "";
  opacity: 0.58;
}

.hero-content {
  width: min(100% - 40px, var(--container));
  margin: 0 auto;
  padding: 110px 0;
}

.hero .eyebrow {
  color: var(--teal-400);
}

.hero h1 {
  max-width: 850px;
  margin: 18px 0 22px;
  font-size: clamp(2.7rem, 7vw, 5.4rem);
  line-height: 0.98;
  letter-spacing: -0.055em;
}

.hero-lead {
  max-width: 710px;
  margin: 0;
  color: rgba(255, 255, 255, 0.78);
  font-size: clamp(1rem, 2vw, 1.18rem);
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

/* =========================================================
   Mission
   ========================================================= */

#mission {
  background: var(--white);
}

.mission-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.35fr;
  gap: 64px;
  align-items: center;
}

.mission-main h3 {
  margin: 10px 0 0;
  color: var(--navy-950);
  font-size: clamp(1.8rem, 3vw, 2.7rem);
  line-height: 1.12;
  letter-spacing: -0.035em;
}

.mission-statement {
  position: relative;
  margin: 0;
  padding: 30px 34px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background:
    linear-gradient(135deg, rgba(24, 183, 160, 0.08), rgba(255, 255, 255, 0.9)),
    var(--surface);
  box-shadow: var(--shadow-sm);
  color: var(--navy-800);
  font-size: clamp(1.25rem, 2.4vw, 1.65rem);
  font-weight: 700;
  line-height: 1.5;
}

.mission-statement::before {
  position: absolute;
  top: 26px;
  bottom: 26px;
  left: 0;
  width: 4px;
  border-radius: 0 5px 5px 0;
  background: var(--teal-500);
  content: "";
}

/* =========================================================
   Capabilities
   ========================================================= */

#capabilities {
  background: var(--surface);
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.card {
  position: relative;
  min-height: 235px;
  padding: 30px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--white);
  box-shadow: var(--shadow-sm);
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.card::after {
  position: absolute;
  right: -45px;
  bottom: -55px;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: var(--teal-soft);
  content: "";
}

.card:hover {
  border-color: rgba(24, 183, 160, 0.3);
  box-shadow: var(--shadow-md);
  transform: translateY(-4px);
}

.card-number {
  display: inline-flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--teal-soft);
  color: var(--teal-500);
  font-size: 0.8rem;
  font-weight: 850;
}

.card h3 {
  position: relative;
  z-index: 1;
  margin: 25px 0 9px;
  color: var(--navy-950);
  font-size: 1.18rem;
  line-height: 1.25;
}

.card p {
  position: relative;
  z-index: 1;
  margin: 0;
  color: var(--text-soft);
  font-size: 0.94rem;
}

/* =========================================================
   Approach
   ========================================================= */

.approach {
  background: var(--white);
}

.approach-content {
  max-width: 900px;
  margin: 0 auto;
  padding: 58px;
  border: 1px solid rgba(24, 183, 160, 0.18);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(135deg, rgba(24, 183, 160, 0.08), rgba(214, 173, 85, 0.06)),
    var(--surface);
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.approach-content h2 {
  margin: 0 0 16px;
  color: var(--navy-950);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.1;
  letter-spacing: -0.04em;
}

.approach-content p {
  max-width: 650px;
  margin: 0 auto;
  color: var(--text-soft);
  font-size: 1.08rem;
}

/* =========================================================
   Values
   ========================================================= */

.values {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--border);
  box-shadow: var(--shadow-sm);
}

.values > * {
  min-height: 150px;
  padding: 28px 24px;
  background: var(--white);
}

.values h3 {
  margin: 0 0 8px;
  color: var(--navy-950);
  font-size: 1.05rem;
}

.values p {
  margin: 0;
  color: var(--text-soft);
  font-size: 0.9rem;
}

/* =========================================================
   Future
   ========================================================= */

.future {
  position: relative;
  overflow: hidden;
  background: var(--navy-950);
  color: var(--white);
}

.future::before {
  position: absolute;
  top: -160px;
  right: -100px;
  width: 430px;
  height: 430px;
  border-radius: 50%;
  background: rgba(24, 183, 160, 0.12);
  content: "";
}

.future-content {
  position: relative;
  max-width: 850px;
  margin: 0 auto;
  text-align: center;
}

.future-content h2 {
  margin: 12px 0 16px;
  color: var(--white);
  font-size: clamp(2rem, 4vw, 3.2rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
}

.future-content p {
  margin: 0 auto;
  color: rgba(255, 255, 255, 0.72);
  font-size: 1.05rem;
}

/* =========================================================
   Guardian-Core
   ========================================================= */

.guardian-section {
  position: relative;
  background:
    radial-gradient(circle at 90% 10%, rgba(24, 183, 160, 0.1), transparent 28%),
    var(--surface);
}

.guardian-card {
  position: relative;
  overflow: hidden;
  display: grid;
  grid-template-columns: 92px minmax(0, 1fr);
  gap: 30px;
  padding: 48px;
  border: 1px solid rgba(24, 183, 160, 0.2);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(135deg, #071521, #0b1f31 58%, #0d2939);
  color: var(--white);
  box-shadow: var(--shadow-lg);
}

.guardian-card::before {
  position: absolute;
  right: -130px;
  bottom: -180px;
  width: 430px;
  height: 430px;
  border: 1px solid rgba(24, 183, 160, 0.15);
  border-radius: 50%;
  content: "";
}

.guardian-icon {
  position: relative;
  z-index: 1;
  width: 76px;
  height: 76px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(54, 212, 189, 0.3);
  border-radius: 22px;
  background: rgba(24, 183, 160, 0.1);
  color: var(--teal-400);
  font-size: 2rem;
  font-weight: 900;
}

.guardian-content {
  position: relative;
  z-index: 1;
}

.guardian-status {
  margin: 0 0 12px;
  color: var(--teal-400);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.guardian-tagline {
  margin: 0 0 16px;
  color: var(--white);
  font-size: clamp(1.7rem, 3.5vw, 2.7rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.04em;
}

.guardian-content > p {
  max-width: 800px;
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
}

.guardian-capabilities {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 30px;
}

.guardian-capabilities > * {
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.045);
  color: rgba(255, 255, 255, 0.84);
  font-size: 0.9rem;
}

.guardian-capabilities > *::before {
  display: inline-block;
  width: 7px;
  height: 7px;
  margin-right: 10px;
  border-radius: 50%;
  background: var(--teal-400);
  content: "";
  vertical-align: middle;
}

.guardian-verified {
  margin-top: 34px;
  padding: 26px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.045);
}

.guardian-verified-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 18px;
}

.guardian-verified-heading h3 {
  margin: 0;
  color: var(--white);
  font-size: 1.05rem;
}

.guardian-verification-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.guardian-verification-grid > * {
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.84rem;
}

.guardian-verification-grid > *::before {
  margin-right: 8px;
  color: var(--teal-400);
  content: "✓";
  font-weight: 900;
}

.guardian-verification-note {
  margin: 18px 0 0;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.78rem;
}

.guardian-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-top: 30px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.guardian-footer > * {
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.82rem;
}

/* =========================================================
   Hibba Welfare Foundation
   ========================================================= */

.hibha-section {
  background: var(--white);
}

.hibha-card {
  display: grid;
  grid-template-columns: 130px minmax(0, 1fr);
  gap: 32px;
  align-items: center;
  padding: 42px;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(135deg, rgba(214, 173, 85, 0.07), rgba(24, 183, 160, 0.04)),
    var(--surface);
  box-shadow: var(--shadow-sm);
}

.hibha-logo-wrap {
  display: grid;
  min-height: 130px;
  place-items: center;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--white);
}

.hibha-logo {
  width: 100%;
  max-width: 105px;
  max-height: 105px;
  object-fit: contain;
}

.hibha-content {
  min-width: 0;
}

.hibha-kicker {
  margin: 0 0 8px;
  color: var(--gold-500);
  font-size: 0.73rem;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hibha-content h2 {
  margin: 0 0 10px;
  color: var(--navy-950);
  font-size: clamp(1.7rem, 3vw, 2.35rem);
  line-height: 1.12;
  letter-spacing: -0.035em;
}

.hibha-content > p {
  margin: 0;
  color: var(--text-soft);
}

.hibha-services {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
  margin-top: 24px;
}

.hibha-service {
  padding: 11px 13px;
  border-radius: 9px;
  background: var(--white);
  color: var(--text-soft);
  font-size: 0.84rem;
}

.hibha-contact {
  margin-top: 24px;
}

.hibha-contact a {
  color: var(--teal-500);
  font-weight: 750;
  text-decoration: none;
}

.hibha-contact a:hover {
  text-decoration: underline;
}

.hibha-mission {
  margin: 20px 0 0;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  color: var(--navy-800);
  font-size: 0.94rem;
}

.hibha-note {
  margin: 10px 0 0;
  color: var(--text-soft);
  font-size: 0.78rem;
}

/* =========================================================
   Contact
   ========================================================= */

#contact {
  background: var(--surface);
}

.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 35px;
  padding: 48px;
  border-radius: var(--radius-xl);
  background: var(--navy-950);
  color: var(--white);
  box-shadow: var(--shadow-lg);
}

.contact-logo {
  width: 58px;
  height: 58px;
  margin-bottom: 18px;
  object-fit: contain;
}

.contact-card h2 {
  margin: 0 0 8px;
  color: var(--white);
  font-size: clamp(1.7rem, 3vw, 2.5rem);
  line-height: 1.1;
}

.contact-card p {
  margin: 0;
  color: rgba(255, 255, 255, 0.68);
}

.contact-card a {
  color: var(--teal-400);
  font-weight: 750;
  text-decoration: none;
}

.contact-card a:hover {
  text-decoration: underline;
}

/* =========================================================
   Footer
   ========================================================= */

footer {
  background: #030a12;
  color: var(--white);
}

.footer-brand {
  width: min(100% - 40px, var(--container));
  margin: 0 auto;
  padding: 42px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.footer-brand img {
  width: 42px;
  height: 42px;
  margin-bottom: 8px;
  object-fit: contain;
}

.footer-brand strong,
.footer-brand span {
  display: block;
}

.footer-brand strong {
  font-size: 0.95rem;
}

.footer-brand span {
  color: rgba(255, 255, 255, 0.48);
  font-size: 0.78rem;
}

footer p {
  margin: 0;
  color: rgba(255, 255, 255, 0.48);
  font-size: 0.78rem;
}

/* =========================================================
   Responsive — tablet
   ========================================================= */

@media (max-width: 980px) {
  :root {
    --header-height: auto;
  }

  .header-brand {
    min-height: auto;
    padding: 14px 0;
    align-items: flex-start;
  }

  .site-nav {
    flex-wrap: wrap;
  }

  .mission-grid {
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .values {
