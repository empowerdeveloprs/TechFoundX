  background:
    linear-gradient(
      105deg,
      #b9e9df 0%,
      #d4eee0 48%,
      #eee6bd 100%
    );
  border-bottom: 1px solid rgba(7, 59, 112, 0.14);
}

/* Brand */
.brand-empower {
  color: #073b70 !important;
}

.brand-developers {
  color: #9a7520 !important;
}

/* Main heading */
.hero h1 {
  color: #063b73;
  text-shadow: 0 2px 0 rgba(255, 255, 255, 0.30);
}

.hero-lead {
  color: #285575;
}

/* Eyebrow */
.hero .eyebrow {
  color: #075fa8;
}

.hero .eyebrow::before {
  background: #075fa8;
}

/* Primary button */
.hero .button.primary {
  background: #e5b936;
  color: #073b70;
  border-color: #e5b936;
  box-shadow: 0 10px 24px rgba(7, 59, 112, 0.14);
}

.hero .button.primary:hover {
  background: #d7aa27;
  color: #052f5d;
}

/* Secondary button */
.hero .button.secondary {
  background: rgba(231, 248, 247, 0.72);
  border-color: rgba(7, 59, 112, 0.26);
  color: #073b70;
}

.hero .button.secondary:hover {
  background: rgba(242, 252, 251, 0.94);
  border-color: #168fc2;
}

/* Hero capability strip */
.hero-capabilities {
  border-top-color: rgba(7, 59, 112, 0.16);
}

.hero-capability {
  color: #164c70;
  border-right-color: rgba(7, 59, 112, 0.16);
}

.hero-capability::before {
  background: #087f9e;
}

/* =========================================================
   ALL MAJOR SECTIONS — LIGHT BLUE FAMILY
   ========================================================= */

#mission,
#capabilities,
.approach,
.values,
.future,
#contact {
  background:
    linear-gradient(
      180deg,
      #d9f0f4 0%,
      #cfeaf1 100%
    );
  color: #073b70;
}

/* Section headings */
.section-heading h2,
.mission-main h3 {
  color: #073b70;
}

/* Cards */
.card,
.mission-statement,
.approach-content,
.contact-card {
  background: rgba(238, 249, 251, 0.82);
  border-color: rgba(7, 59, 112, 0.12);
  box-shadow: 0 12px 32px rgba(7, 59, 112, 0.07);
}

/* Card titles */
.card h3 {
  color: #073b70;
}

/* Card text */
.card p,
.mission-main p,
.approach-content p {
  color: #365d73;
}

/* Values */
.values {
  background:
    linear-gradient(
      180deg,
      #d5edf2,
      #c9e6ed
    );
}

/* Future */
.future {
  background:
    linear-gradient(
      135deg,
      #c8e9ef,
      #d9f1f2
    );
}

/* =========================================================
   GUARDIAN-CORE — LIGHT BLUE PRODUCT AREA
   ========================================================= */

.guardian-section {
  background:
    linear-gradient(
      135deg,
      #c5e8f1 0%,
      #d9f1f4 100%
    );
}

.guardian-card {
  background: rgba(239, 250, 252, 0.88);
  border-color: rgba(7, 59, 112, 0.13);
  box-shadow: 0 16px 42px rgba(7, 59, 112, 0.09);
}

.guardian-card h3,
.guardian-card h2 {
  color: #073b70;
}

/* =========================================================
   HIBBA — LIGHT BLUE SECONDARY SECTION
   ========================================================= */

.hibha-section {
  background:
    linear-gradient(
      180deg,
      #d6eef3,
      #cbe8ef
    );
}

.hibha-card {
  background: rgba(239, 249, 251, 0.84);
  border-color: rgba(7, 59, 112, 0.12);
}

/* =========================================================
   FOOTER — CLEAN LIGHT BLUE
   ========================================================= */

.site-footer {
  background:
    linear-gradient(
      180deg,
      #c4e3ed,
      #b9dce8
    );
  color: #073b70;
  border-top: 1px solid rgba(7, 59, 112, 0.14);
}

.footer-brand strong {
  color: #073b70;
}

.footer-brand span {
  color: #365d73;
}

/* =========================================================
   BLUE AJRAK DETAIL — LIGHT AND CONTROLLED
   ========================================================= */

.section::before {
  background-image:
    url("assets/ajrak-header-pattern.svg");
  background-size: 420px auto;
  opacity: 0.045;
  pointer-events: none;
}

/* Keep text above decorative pattern */
.section > * {
  position: relative;
  z-index: 1;
}

/* Strong text separation */
.hero h1,
.section-heading h2,
.mission-main h3,
.card h3,
.guardian-card h3,
.hibha-card h3 {
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
}

/* Mobile */
@media (max-width: 720px) {
  .hero {
    background:
      linear-gradient(
        135deg,
        #c4efeb,
        #d0f1ef
      );
  }

  .hero::before {
    background-size: 300px auto;
    opacity: 0.65;
  }

  .section::before {
    background-size: 300px auto;
    opacity: 0.025;
  }
}


