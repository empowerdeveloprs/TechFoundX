:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #172033;
  background: #f7f9fc;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
}

button,
input {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

.app {
  min-height: 100vh;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 6vw;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid #e8ecf2;
  backdrop-filter: blur(14px);
}

.brand {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.brand-tagline {
  margin-top: 2px;
  color: #68738a;
  font-size: 0.72rem;
}

.main-nav {
  display: flex;
  gap: 26px;
  color: #4f5b72;
  font-size: 0.92rem;
}

.main-nav a:hover,
.hero-links a:hover,
.action-card a:hover {
  color: #175cd3;
}

.header-actions {
  display: flex;
  gap: 10px;
}

.button {
  border: 0;
  border-radius: 10px;
  padding: 11px 17px;
  cursor: pointer;
  font-weight: 700;
}

.button-primary {
  color: white;
  background: #175cd3;
}

.button-secondary {
  color: #24324a;
  background: #eef2f7;
}

.hero {
  min-height: 650px;
  display: flex;
  align-items: center;
  padding: 90px 6vw;
  background:
    radial-gradient(circle at 80% 20%, rgba(23, 92, 211, 0.13), transparent 30%),
    linear-gradient(135deg, #ffffff 0%, #f1f6ff 100%);
}

.hero-content {
  width: min(900px, 100%);
}

.eyebrow {
  color: #175cd3;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.hero h1 {
  margin: 18px 0;
  font-size: clamp(3.2rem, 8vw, 6.8rem);
  line-height: 0.91;
  letter-spacing: -0.07em;
}

.hero p {
  max-width: 680px;
  color: #59657a;
  font-size: 1.18rem;
  line-height: 1.7;
}

.search-box {
  display: flex;
  max-width: 760px;
  margin-top: 34px;
  padding: 7px;
  gap: 8px;
  background: white;
  border: 1px solid #dfe5ee;
  border-radius: 14px;
  box-shadow: 0 18px 50px rgba(31, 49, 79, 0.09);
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  padding: 12px 14px;
  color: #172033;
}

.hero-links {
  display: flex;
  gap: 10px;
  margin-top: 20px;
  color: #175cd3;
  font-size: 0.9rem;
}

.section {
  padding: 100px 6vw;
}

.section-heading {
  max-width: 720px;
  margin-bottom: 42px;
}

.section-heading h2 {
  margin: 10px 0;
  font-size: clamp(2rem, 4vw, 3.5rem);
  letter-spacing: -0.05em;
}

.section-heading p {
  color: #68738a;
  line-height: 1.7;
}

.action-grid,
.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.action-card,
.category-card {
  background: white;
  border: 1px solid #e5eaf1;
  border-radius: 16px;
}

.action-card {
  min-height: 245px;
  padding: 26px;
}

.action-card h3 {
  margin-top: 0;
}

.action-card p {
  min-height: 105px;
  color: #68738a;
  line-height: 1.65;
}

.action-card a {
  color: #175cd3;
  font-weight: 700;
}

.category-grid {
  grid-template-columns: repeat(4, 1fr);
}

.category-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22px;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.category-card:hover {
  transform: translateY(-3px);
  border-color: #b8cdf2;
}

.category-card strong {
  color: #175cd3;
}

.featured {
  background: #eef4ff;
}

.featured-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  padding: 42px;
  background: white;
  border: 1px solid #dfe7f4;
  border-radius: 20px;
}

.badge {
  color: #175cd3;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.featured-card h3 {
  margin: 12px 0;
  font-size: 2rem;
}

.featured-card p {
  max-width: 650px;
  color: #68738a;
  line-height: 1.7;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.steps > div {
  border-top: 2px solid #175cd3;
  padding-top: 20px;
}

.steps span {
  color: #175cd3;
  font-weight: 800;
}

.steps h3 {
  margin-bottom: 8px;
}

.steps p {
  color: #68738a;
  line-height: 1.6;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  gap: 30px;
  padding: 50px 6vw;
  color: #68738a;
  background: #111827;
}

.site-footer strong {
  color: white;
}

.site-footer p {
  margin: 5px 0 0;
}

@media (max-width: 900px) {
  .main-nav {
    display: none;
  }

  .action-grid,
  .category-grid,
  .steps {
    grid-template-columns: repeat(2, 1fr);
  }

  .featured-card {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 600px) {
  .site-header {
    padding: 15px 5vw;
  }

  .header-actions .button-secondary {
    display: none;
  }

  .hero {
    min-height: 580px;
    padding: 70px 5vw;
  }

  .hero h1 {
    font-size: clamp(3rem, 17vw, 5rem);
  }

  .search-box {
    flex-direction: column;
  }

  .search-box .button {
    width: 100%;
  }

  .section {
    padding: 70px 5vw;
  }

  .action-grid,
  .category-grid,
  .steps {
    grid-template-columns: 1fr;
  }

  .featured-card {
    padding: 28px;
  }

  .site-footer {
    flex-direction: column;
  }
}
